SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SECRET
GROWTH_AUTH_USER_ID=YOUR_EXISTING_AUTH_USER_UUID

# 正式主線：OpenCLI Browser + Chrome ChatGPT Web
GROWTH_OPENCLI_BROWSER_SESSION=growthbrain
GROWTH_CHATGPT_CONVERSATION_TITLE="Growth Brain Worker"

# 建議：第一次確認固定對話後填入，可避免切到錯對話。
# GROWTH_CHATGPT_CONVERSATION_URL=https://chatgpt.com/c/YOUR_CONVERSATION_ID

GROWTH_WORKER_ID=mac-opencli-browser-growthbrain
GROWTH_PROVIDER_KEY=chatgpt_web_opencli
GROWTH_POLL_MS=4000
GROWTH_HEARTBEAT_MS=15000
GROWTH_CHATGPT_TIMEOUT_MS=240000

# Optional: explicit OpenCLI binary path
# OPENCLI_BIN=/opt/homebrew/bin/opencli
# NODE_BIN=/opt/homebrew/bin/node

# Set to 1 to claim/process at most one job, then exit:
# GROWTH_RUN_ONCE=1
