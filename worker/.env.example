SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SECRET
GROWTH_AUTH_USER_ID=YOUR_EXISTING_AUTH_USER_UUID
GROWTH_WORKER_ID=mac-growth-worker
GROWTH_PROVIDER_KEY=chatgpt_web_bridge
CHATGPT_BRIDGE_URL=http://127.0.0.1:8080
CHATGPT_MODEL=auto
GROWTH_POLL_MS=4000
# Optional if your local bridge is configured with an API key:
# CHATGPT_BRIDGE_API_KEY=
# Set to 1 to claim/process at most one job, then exit:
# GROWTH_RUN_ONCE=1
